# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).

# WAJIB. Kunci penanda tangan cookie session.
# Buat nilai acak yang panjang, misalnya:  openssl rand -hex 32
# Tanpa ini server tetap jalan, tapi memakai secret acak yang berbeda tiap
# restart sehingga semua user langsung logout.
SESSION_SECRET=

# Opsional. Jumlah putaran bcrypt. Default 10.
# Naikkan bila login terasa lambat di perangkat kecil (mis. 12-13).
BCRYPT_ROUNDS=10